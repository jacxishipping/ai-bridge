[Unit]
Description=AI Bridge Linux Server Agent (autonomous server maintenance & orchestration)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ai-bridge
EnvironmentFile=-/etc/ai-bridge/agent.env
ExecStart=/opt/ai-bridge/.venv/bin/python agents/linux/agent_main.py run
Restart=always
RestartSec=5
KillMode=process
LimitNOFILE=65536
TasksMax=infinity

[Install]
WantedBy=multi-user.target
