{
  "protocol": "ai-bridge-windows-named-pipe",
  "version": "1.0.0",
  "pipe_name": "\\\\.\\pipe\\AIBridgeDesktopPipe",
  "security": {
    "sddl": "D:(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;AU)",
    "authentication": "HMAC-SHA256 per-message token verification",
    "max_message_bytes": 65536,
    "single_interactive_session_v1": true
  },
  "message_types": [
    "REGISTER_DESKTOP_AGENT",
    "HEARTBEAT_PING",
    "HEARTBEAT_PONG",
    "START_WEBRTC_SESSION",
    "STOP_WEBRTC_SESSION",
    "UPDATE_SESSION_PERMISSIONS",
    "HUMAN_TAKEOVER_STATE",
    "INJECT_INPUT_EVENT",
    "RELEASE_ALL_INPUT",
    "CAPTURE_SCREENSHOT_REQUEST",
    "CAPTURE_SCREENSHOT_RESPONSE",
    "DESKTOP_STATUS_REPORT",
    "SESSION_STATE_CHANGED"
  ]
}
