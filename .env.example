# Copy to .env (never commit it) and set restrictive permissions: chmod 600 .env
# Workspace the AI may touch. Nothing outside this directory is exposed.
AI_BRIDGE_WORKSPACE=$HOME/ai-bridge-workspace
# Control plane
AI_BRIDGE_CONTROL_URL=http://127.0.0.1:8000
AI_BRIDGE_CONTROL_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_BRIDGE_ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN
# Device token, obtained once at enrollment (dashboard shows it once).
AI_BRIDGE_DEVICE_TOKEN=
# Tier-3 sensitive changes (edit/move/deploy). 0 = require approval queue instead.
AI_BRIDGE_ALLOW_TIER3=0
# Desktop automation: explicit opt-in only, interactive session only.
AI_BRIDGE_DESKTOP_ENABLED=0
AI_BRIDGE_ALLOWED_APPS=
AI_BRIDGE_ALLOWED_SERVICES=
AI_BRIDGE_DATA_DIR=$HOME/.ai-bridge
